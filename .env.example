# Security: DO NOT commit your actual .env or .env.local file!
# Copy this file to .env.local and fill in your private API credentials.

# 1. CORE SYSTEM SECURITY (Checklist 3.1, 3.2, 3.6)
# Pass this key via 'x-system-key' header or 'system_key' cookie for API requests.
# Generate with: openssl rand -hex 32
SYSTEM_API_KEY=replace_with_a_secure_random_64_char_hex_token

# 2. AI REASONING BRAIN (Checklist 1.3 - Server-only)
GEMINI_API_KEY=
# Optional secondary/fallback AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# 3. MARITIME TRACKING (AISStream WebSocket)
AISSTREAM_API_KEY=

# 4. AVIATION SURVEILLANCE (OpenSky Network)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# 5. SATELLITE & SENSORS (NASA FIRMS)
FIRMS_MAP_KEY=

# 6. LOCAL PERSISTENCE & SYSTEM CONFIG
DATA_DIR=./data
DATABASE_NAME=intelligence.db
NODE_ENV=development
PORT=3000
